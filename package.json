{
  "name": "dsh-mastodon-toot",
  "version": "0.3.11",
  "description": "部署在 Mastodon 的大肥鱼 bot：自己发 toot、自己回嘟文，带一个小本本，记下聊过的人和话。DeepSeek Harness 插件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mastodon",
    "bot",
    "notebook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowdan/dsh-mastodon-toot.git"
  },
  "homepage": "https://github.com/meowdan/dsh-mastodon-toot#readme",
  "bugs": {
    "url": "https://github.com/meowdan/dsh-mastodon-toot/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
